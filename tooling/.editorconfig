# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

# shfmt reads these settings
[*.{sh,bash,sbatch}]
indent_style = tab
switch_case_indent = true

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{java,kt,kts,gradle}]
indent_size = 4
