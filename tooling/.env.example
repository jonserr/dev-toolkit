# Copy to .env and fill in values
# Never commit .env

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=example-password
DATABASE_URL=postgresql://app:example-password@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379/0

# External services
API_BASE_URL=http://localhost:8000
API_TOKEN=example-token
